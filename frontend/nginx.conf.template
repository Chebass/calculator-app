# Rendered by the nginx image's envsubst step (see Dockerfile). Only the
# variables below are substituted; nginx's own $variables are left alone.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # /api/calc/v1/...    -> calculator-service /api/v1/...
    location /api/calc/ {
        proxy_pass http://${CALCULATOR_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
    }

    # /api/history/v1/... -> history-service /api/v1/...
    location /api/history/ {
        proxy_pass http://${HISTORY_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
    }

    # Hashed build assets can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app fallback.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
